{
  "version": 1,
  "mode": "enforce",
  "defaults": {"decision": "deny"},
  "tools": {
    "read_file": {"decision": "allow", "paths": ["/tmp/agentfence/*"]},
    "fetch": {"decision": "allow", "schemes": ["https"], "hosts": ["example.com"]},
    "needs_human": {"decision": "require_approval"}
  },
  "network": {"allowed_schemes": ["https"], "allowed_hosts": ["example.com"]},
  "budgets": {"max_input_bytes": 65536, "max_result_bytes": 262144, "max_lines": 1000, "max_frame_bytes": 1048576, "timeout_seconds": 30},
  "redaction": {"keys": ["password", "token", "secret", "api_key", "authorization"], "patterns": ["(?i)bearer [A-Za-z0-9._-]+"]}
}
